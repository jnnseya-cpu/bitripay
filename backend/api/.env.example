# --- Core ---
PORT=4000
NODE_ENV=development
APP_NAME=BitriPay
# Public URL of the customer web app (used in QR links, checkout redirects, emails)
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000
# Long random strings (32+ characters). JWT_SECRET signs tokens; APP_SECRET encrypts card numbers and gateway credentials.
# In production the API refuses to start while these are unset, shorter than 32 characters or still development defaults.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
APP_SECRET=change-me-to-another-long-random-string
DATABASE_PATH=./data/bitripay.db
BASE_CURRENCY=USD

# --- Bootstrap admin (created on first start if no admin exists) ---
# Production refuses the default password; use 12+ characters.
ADMIN_EMAIL=admin@bitripay.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=BitriPay Admin

# --- Card processor (only if you accept payment cards; sandbox gateway is always available in development) ---
# Stripe (cards)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Paystack (cards, bank, mobile money in NG/GH/KE/ZA)
PAYSTACK_SECRET_KEY=
# Flutterwave (cards, mobile money across Africa, bank)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Mobile money, bank transfer, QR, wallet transfers, cross-payments and remittance need no further setting here: they run
# on the BitriPay digital rail (ledger, operator collection numbers and bank details entered in the console, payout
# devices, agents). Operator-API adapters (MTN MoMo, M-Pesa Daraja) and BTCPay are optional extras a deployment may
# contract; their settings live in .env.optional-integrations.example and are never required.
# Rails whose environment credentials pass their connectivity check are enabled at start-up (0 = keep manual activation)
RAILS_AUTO_ENABLE=1

# --- Email OTP / notifications (optional; without SMTP codes are logged to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BitriPay <support@bitripay.com>"

# --- SMS OTP (optional; without a provider codes are logged to the console) ---
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Push notifications (Expo push service; no key required for basic use) ---
EXPO_ACCESS_TOKEN=

# --- Passkeys / biometric login (WebAuthn) ---
# Relying party ID: the registrable domain of your web app (defaults to the WEB_URL hostname)
WEBAUTHN_RP_ID=
# Extra allowed origins, comma separated (WEB_URL and ADMIN_URL are always allowed)
WEBAUTHN_ORIGINS=

# National switch adapter (path to a certified connector module; empty = not configured)
SWITCH_ADAPTER_MODULE=

# --- Assist agents and the content agent (optional; keys can also be stored encrypted in admin settings) ---
ANTHROPIC_API_KEY=

# --- Demo seed (npm run seed) ---
# Country of the demo accounts; demo wallets follow BASE_CURRENCY plus EUR and NGN
SEED_COUNTRY=US
# Set to 1 to keep the demo payout device's private key on disk for scripts/e2e-corridor.mjs (never in production)
SEED_WRITE_DEVICE_KEY=0
