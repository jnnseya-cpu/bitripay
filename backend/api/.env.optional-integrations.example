# Optional external integrations. NONE of these is required: transfers, QR payments, mobile money, bank transfer,
# cross-payments and remittance run on the BitriPay digital rail (ledger, your collection numbers at each operator,
# bank-transfer instructions, payout devices, agents) without any bank, mobile-money operator or BTCPay API.
# Copy a block into .env only for a deployment that has contracted that adapter; every value stays empty otherwise.

# MTN Mobile Money (Collections API)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENV=sandbox
# Safaricom M-Pesa (Daraja STK Push)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
# Bitcoin rail through BTCPay Server (Greenfield API). Empty = sandbox invoices only.
BTCPAY_SERVER_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_NETWORK=mainnet
# Collection numbers can also be pre-filled from the environment instead of the console (same effect, optional): operator=collection number[:account name], separated by ";"
# e.g. MOMO_DIRECT_RAILS="orange_cd=+243890000100:BitriPay SARL;mpesa_ke=+254700000100"
MOMO_DIRECT_RAILS=
