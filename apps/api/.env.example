# --- Core ---
PORT=4000
NODE_ENV=development
APP_NAME=BitriPay
# Public URL of the customer web app (used in QR links, checkout redirects, emails)
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000
# Long random strings. JWT_SECRET signs tokens; APP_SECRET encrypts card numbers and gateway credentials.
JWT_SECRET=change-me-to-a-long-random-string
APP_SECRET=change-me-to-another-long-random-string
DATABASE_PATH=./data/bitripay.db
BASE_CURRENCY=USD

# --- Bootstrap admin (created on first start if no admin exists) ---
ADMIN_EMAIL=admin@bitripay.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=BitriPay Admin

# --- Payment gateways (all optional; sandbox gateway is always available in development) ---
# Stripe (cards)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Paystack (cards, bank, mobile money in NG/GH/KE/ZA)
PAYSTACK_SECRET_KEY=
# Flutterwave (cards, mobile money across Africa, bank)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# MTN Mobile Money (Collections API)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENV=sandbox
# Safaricom M-Pesa (Daraja STK Push)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox

# --- Email OTP / notifications (optional; without SMTP codes are logged to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BitriPay <no-reply@bitripay.local>"

# --- SMS OTP (optional; without a provider codes are logged to the console) ---
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Push notifications (Expo push service; no key required for basic use) ---
EXPO_ACCESS_TOKEN=
