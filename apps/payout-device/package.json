{
  "name": "@bitripay/payout-device",
  "version": "1.0.0",
  "private": true,
  "description": "BitriPay Android payout device & SMS forwarder: executes local mobile-money payouts from a merchant SIM and forwards signed operator confirmations",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/protocol.test.ts test/forwarder.test.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.5",
    "expo-crypto": "~14.1.4",
    "expo-device": "~7.1.4",
    "expo-linking": "~7.1.4",
    "expo-local-authentication": "~16.0.4",
    "expo-secure-store": "~14.2.3",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
