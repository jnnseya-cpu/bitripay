{
  "expo": {
    "name": "BitriPay",
    "slug": "bitripay",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bitripay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#151537",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bitripay.app",
      "infoPlist": {
        "NSCameraUsageDescription": "BitriPay uses the camera to scan payment QR codes.",
        "NSFaceIDUsageDescription": "BitriPay uses Face ID to unlock the app."
      },
      "associatedDomains": ["applinks:www.bitripay.com"]
    },
    "android": {
      "package": "com.bitripay.app",
      "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT", "POST_NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.bitripay.com",
              "pathPrefix": "/q"
            },
            {
              "scheme": "https",
              "host": "www.bitripay.com",
              "pathPrefix": "/pay"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E2A7B"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BitriPay to access your camera to scan QR codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow BitriPay to use Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb",
          "sounds": ["./assets/sounds/loud_alert.wav"]
        }
      ],
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000",
      "webUrl": "http://localhost:5173",
      "eas": {
        "projectId": ""
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
