# Copy to deploy/.env.production (git-ignored) and fill every value before `npm run deploy`.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DOMAIN=bitripay.com
ACME_EMAIL=ops@bitripay.com
NODE_ENV=production
BASE_CURRENCY=USD
APP_NAME=BitriPay

# --- Secrets (production refuses to start with defaults or short values) ---
JWT_SECRET=
APP_SECRET=
ADMIN_EMAIL=admin@bitripay.com
ADMIN_PASSWORD=
ADMIN_NAME=BitriPay Administrator

# --- Card processors (provide the live keys of the ones you contract with; each is health-checked and enabled at start-up) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Mobile money APIs ---
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=production

# --- Direct mobile-money rails: your prefunded operator SIMs (operator=collection number:account name; ";" separated) ---
MOMO_DIRECT_RAILS=orange_cd=+243XXXXXXXXX:BitriPay SARL;mpesa_ke=+254XXXXXXXXX:BitriPay Ltd

# --- Bitcoin rail (BTCPay Server, Greenfield API) ---
BTCPAY_SERVER_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_NETWORK=mainnet

# --- National switch adapter (only after the official profile and certification; empty keeps simulation) ---
SWITCH_ADAPTER_MODULE=

# --- Messaging ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BitriPay <no-reply@bitripay.com>
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EXPO_ACCESS_TOKEN=

# --- Assist agents and content agent ---
ANTHROPIC_API_KEY=

# --- Activation policy ---
RAILS_AUTO_ENABLE=1
