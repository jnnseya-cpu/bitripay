# Copy to deploy/.env.production (git-ignored) and fill every value before `npm run deploy`.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DOMAIN=bitripay.com
ACME_EMAIL=support@bitripay.com
NODE_ENV=production
BASE_CURRENCY=USD
APP_NAME=BitriPay

# --- Secrets (production refuses to start with defaults or short values) ---
JWT_SECRET=
APP_SECRET=
# Sign-in identifier of the first administrator. support@bitripay.com is the only mailbox that exists: password resets
# for this account are sent to ADMIN_EMAIL, so either create this mailbox on Hostinger or use support@bitripay.com here.
ADMIN_EMAIL=admin@bitripay.com
ADMIN_PASSWORD=
ADMIN_NAME=BitriPay Administrator

# --- Money movement ---
# Transfers, QR payments, cross-payments and remittance run on the BitriPay digital rail: the double-entry ledger,
# your own collection numbers at each mobile-money operator, bank-transfer instructions, prefunded payout accounts,
# Android payout devices and agents. No bank, mobile-money operator or BTCPay API is needed and none is configured here.
# Collection numbers, payout accounts and payout devices are enrolled in the console (Mobile money, Corridors → Liquidity)
# and the payout-device app after the first sign-in.

# --- Card processor (only if you accept payment cards; leave empty otherwise) ---
# The one you contract with is health-checked and enabled at start-up. Cards are the only method that uses a processor.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- National switch adapter (only after the official profile and certification; empty keeps simulation) ---
SWITCH_ADAPTER_MODULE=

# --- Messaging (Hostinger mail: create the mailbox support@bitripay.com in hPanel → Emails first; SMTP_PASS is its password) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@bitripay.com
SMTP_PASS=
SMTP_FROM=BitriPay <support@bitripay.com>
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EXPO_ACCESS_TOKEN=

# --- Assist agents and content agent ---
ANTHROPIC_API_KEY=

# --- Shared host only (npm run deploy -- --shared-host): localhost ports the existing web server proxies to ---
BITRIPAY_API_PORT=4000
BITRIPAY_WEB_PORT=8080
BITRIPAY_ADMIN_PORT=8081
# When the reverse proxy is itself a Docker container (Caddy, Traefik, Nginx Proxy Manager): the network it is attached to,
# so it reaches bitripay-web / bitripay-admin / bitripay-api by name (docker network ls). Empty = proxy on the host.
BITRIPAY_EDGE_NETWORK=
# When that proxy is a Caddy container, the deployment merges the BitriPay site blocks into the Caddyfile it mounts and
# reloads it (deploy/shared-host/apply-edge.sh). Name the container here if several Caddy containers share the network;
# set BITRIPAY_EDGE_AUTOCONFIG=0 to leave the proxy untouched.
BITRIPAY_EDGE_PROXY=
BITRIPAY_EDGE_AUTOCONFIG=1

# --- Activation policy (a card processor whose check passes is enabled at start-up; 0 = enable it by hand) ---
RAILS_AUTO_ENABLE=1

# --- Automatic deployment (see deploy/README.md → Deploying from GitHub) ---
# shared-host: this VPS also serves other sites, BitriPay stays on localhost ports behind the existing web server (default)
# dedicated:   Caddy from deploy/Caddyfile takes 80/443 with automatic TLS
DEPLOY_MODE=shared-host
# Branch followed by deploy/auto-deploy.sh (pull-based timer); empty = the branch checked out on the host
AUTO_DEPLOY_BRANCH=
# Optional: fine-grained GitHub token with "Actions: read" on this repository, so the timer can check that CI is green
# before deploying a commit of a private repository. Not needed for the SSH deployment from GitHub Actions.
GITHUB_TOKEN=
